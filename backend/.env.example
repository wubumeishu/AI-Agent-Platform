# ---------------------------------------------------------------------------
# AI Agent Platform backend — environment template.
# Copy to `backend/.env` for a local working config (`.env` is gitignored).
# Real environment variables ALWAYS take precedence over the .env file.
#
# CREDENTIALS POLICY (never hard-code secrets in source):
#   * The code default DATABASE_URL is credential-free and will NOT
#     authenticate against a typical local PostgreSQL.
#   * Supply a working, credentialed DSN via ONE of:
#       - this .env file  (local dev; gitignored)
#       - the environment (CI / containers / a launch script)
#       - a deploy-specific config
#   * The service boots either way, but a down/misconfigured DB is announced
#     with a loud WARNING at boot and is visible on /api/v1/health + /api/v1/health/db.
# ---------------------------------------------------------------------------

# Postgres the service talks to. Use a credentialed DSN for a usable deployment.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_platform
# Separate DB used by integration tests that hit a real Postgres.
DATABASE_TEST_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_platform_test

# Optional strict mode: 1/true/yes -> REFUSE to start when the DB is unreachable.
# Default (unset/0) -> come up anyway; the misconfig is logged loudly at boot.
# DB_REQUIRED_ON_STARTUP=1

# P5MSG-FIX-1 (P0-3/P0-2) trusted-producer Bearer tokens for the realtime
# write seams: POST /api/v1/realtime/publish, POST /api/v1/realtime/read,
# and POST /api/v1/messages/{id}/status. Comma-separated set of static
# Bearer tokens. Default posture is CLOSED: when unset/empty, no caller is
# trusted and every request to these endpoints is rejected (401 for a missing
# token, 403 for an untrusted one). Internal service paths that publish
# realtime events directly are unaffected. Supply the token used by the
# trusted producer that drives delivery state / mark-read / event publish.
# REALTIME_PUBLISH_TOKENS=
